# Required
TELEGRAM_TOKEN=123456789:REPLACE_ME
ALLOWED_USERS=123456789
WEBHOOK_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
COMPOSE_ROOT=/path/to/your/compose/projects

# Optional
# TZ=Asia/Muscat
# TELEGRAM_CHAT_ID=123456789
# LOG_LEVEL=debug

# Optional — Telegram ping when Diun cron finishes with 0 updates
# NOTIFY_EMPTY_SCAN=true
# DIUN_CONTAINER=diun

# Optional — skip noisy images/containers (substring or /regex/)
# SKIP_IMAGES=diun/testnotif,crazymax/diun
# SKIP_CONTAINERS=diun,dockerupbot

# Optional — defer UPDATE notifications during this window (overnight OK)
# QUIET_HOURS=23:00-07:00

# Optional — require Docker HEALTHCHECK "healthy" (not just running)
# REQUIRE_HEALTHY=true

# Optional — prune dangling images after a successful queue
# PRUNE_AFTER_SUCCESS=true
